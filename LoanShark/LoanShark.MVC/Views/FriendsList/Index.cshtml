@model LoanShark.MVC.Models.FriendsListViewModel

@{
    ViewData["Title"] = "FriendsList";
}

<div class="container" style="padding: 20px;">
    <div class="row">
        <!-- Left Column: Friends List -->
        <div class="col-md-6">
            <div class="row align-items-center">
                <div class="col">
                    <h2>Friends</h2>
                </div>
                <div class="col-auto">
                    <button id="addFriendButton" class="btn btn-primary btn-sm">+</button>
                </div>
            </div>

            <div class="row" style="margin: 10px 0;">
                <div class="col">
                    <form id="friendSearchForm" asp-action="Index" asp-controller="FriendsList" method="get">
                        <input type="text" class="form-control" name="friendSearchQuery" id="friendSearchQuery" value="@Model.SearchQuery" placeholder="Search friends..." />
                    </form>
                </div>
            </div>

            <div class="row">
                <div class="col" id="friendsListContainer">
                    @if (Model.NoFriendsVisibility)
                    {
                        <p class="text-center" style="margin-top: 20px;">
                            You have no friends in the friends list. Add a friend to view it here. :)
                        </p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var friend in Model.FriendsList)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@friend.Username</strong>
                                        <div class="text-muted" style="font-size: 12px;">@friend.PhoneNumber</div>
                                    </div>
                                    <form asp-action="RemoveFriend" asp-controller="FriendsList" method="post" class="remove-friend-form">
                                        <input type="hidden" name="friendId" value="@friend.UserID" />
                                        <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            @if (Model.ShowAddFriends)
            {
                @await Html.PartialAsync("~/Views/AddFriends/Index.cshtml", ViewData["AddFriendsModel"])
            }
            else
            {
                <div id="addFriendsContainer"></div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-submit FriendsList search form and load AddFriends
        document.getElementById('friendSearchQuery').addEventListener('input', function () {
            const searchQuery = this.value;
            const searchParams = new URLSearchParams({ friendSearchQuery: searchQuery }).toString();
            fetch(`/FriendsList/Index?${searchParams}`)
                .then(response => response.text())
                .then(html => {
                    // Parse HTML and extract friendsListContainer content
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newFriendsList = doc.querySelector('#friendsListContainer').innerHTML;
                    document.getElementById('friendsListContainer').innerHTML = newFriendsList;
                    // Reattach remove-friend-form event listeners
                    attachRemoveFriendListeners();
                    // Load AddFriends after search
                    fetch('/AddFriends/Index')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById('addFriendsContainer').innerHTML = html;
                        })
                        .catch(error => console.error('Error loading AddFriends:', error));
                })
                .catch(error => console.error('Error loading FriendsList:', error));
        });

        // Load AddFriends view on button click
        document.getElementById('addFriendButton').addEventListener('click', function () {
            fetch('/AddFriends/Index')
                .then(response => response.text())
                .then(html => {
                    document.getElementById('addFriendsContainer').innerHTML = html;
                })
                .catch(error => console.error('Error loading AddFriends:', error));
        });

        // Handle AddFriends search using event delegation
        document.getElementById('addFriendsContainer').addEventListener('input', function (event) {
            if (event.target.id === 'addFriendSearchQuery') {
                const searchQuery = event.target.value;
                fetch(`/AddFriends/Index?addFriendSearchQuery=${encodeURIComponent(searchQuery)}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('addFriendsContainer').innerHTML = html;
                    })
                    .catch(error => console.error('Error loading AddFriends:', error));
            }
        });

        // Function to attach RemoveFriend form listeners
        function attachRemoveFriendListeners() {
            document.querySelectorAll('.remove-friend-form').forEach(form => {
                form.removeEventListener('submit', handleRemoveFriend); // Prevent duplicate listeners
                form.addEventListener('submit', handleRemoveFriend);
            });
        }

        // Handle RemoveFriend form submissions
        function handleRemoveFriend(event) {
            event.preventDefault();
            const form = event.target;
            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData
            })
                .then(response => response.text())
                .then(html => {
                    // Parse HTML and update friendsListContainer
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newFriendsList = doc.querySelector('#friendsListContainer').innerHTML;
                    document.getElementById('friendsListContainer').innerHTML = newFriendsList;
                    // Reattach remove-friend-form event listeners
                    attachRemoveFriendListeners();
                    // Load AddFriends after removal
                    fetch('/AddFriends/Index')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById('addFriendsContainer').innerHTML = html;
                        })
                        .catch(error => console.error('Error loading AddFriends:', error));
                })
                .catch(error => console.error('Error removing friend:', error));
        }

        // Initial attachment of RemoveFriend listeners
        attachRemoveFriendListeners();

        // Auto-load AddFriends view on page load if showAddFriends is true
        @if (Model.ShowAddFriends)
        {
            <text>
                window.addEventListener('load', function () {
                    fetch('/AddFriends/Index')
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById('addFriendsContainer').innerHTML = html;
                        })
                        .catch(error => console.error('Error loading AddFriends:', error));
                });
            </text>
        }
    </script>
}
<style>
    .container {
        max-width: 1200px;
    }

    .list-group-item {
        padding: 10px;
    }

    .btn-sm {
        margin-left: 10px;
    }
</style>