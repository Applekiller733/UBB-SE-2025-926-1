@model LoanShark.MVC.Models.LoansViewModel
@{
    ViewBag.Title = "My Loans";
}

@if (TempData["SuccessMessage"] != null)
{
        <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
}

<div class="container py-4" style="max-width: 900px; margin: auto;">
    <h2 class="text-center mb-4">My Loans</h2>

    @if (Model.Loans.Count > 0)
    {
            <div class="table-responsive bg-dark border rounded shadow-sm">
                <table class="table table-dark table-bordered table-hover mb-0">
                    <thead class="thead-dark text-center">
                        <tr>
                            <th>Loan ID</th>
                            <th>Currency</th>
                            <th>Amount Taken</th>
                            <th>Amount To Pay</th>
                            <th>Date Taken</th>
                            <th>Due Date</th>
                            <th>Nr. Months</th>
                            <th>Tax %</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var loan in Model.UnpaidLoans)
                    {
                                <tr class="text-center">
                                    <td>@loan.LoanID</td>
                                    <td>@loan.Currency</td>
                                    <td>@loan.Amount</td>
                                    <td class="text-success fw-bold">@loan.AmountToPay</td>
                                    <td>@loan.DateTaken.ToShortDateString()</td>
                                    <td>@loan.DateDeadline.ToShortDateString()</td>
                                    <td>@loan.NumberMonths</td>
                                    <td>@loan.TaxPercentage</td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
    }
    else
    {
            <div class="alert alert-secondary text-center mt-4">You don't have any active loans.</div>
    }

    <div class="d-flex justify-content-center mt-4 gap-3">

        <form asp-action="TakeLoan" method="post">
                <button class="btn btn-outline-primary w-100">Take Loan</button>
            </form>
               <form asp-action="PayLoan" method="post">
                <button class="btn btn-outline-primary w-100">Pay Loan</button>
            </form>
    </div>

    <div class="text-center mt-3">
       <form asp-action="Close" method="post">
                <button class="btn btn-outline-primary w-100">Back</button>
            </form>
    </div>
</div>

